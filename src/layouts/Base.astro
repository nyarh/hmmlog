---
import '../styles/main.css';
import Icon from '../components/Icon.astro';
import {email, siteName} from '../lib/blog';
import PreferencePicker from '../components/PreferencePicker.astro';
const { title=siteName, description=siteName+' 개발 블로그. 웹 개발과 블로그 구현에 관한 글을 모읍니다.', article, noindex=false }=Astro.props;
const url=new URL(Astro.url.pathname,Astro.site).href;
const pageTitle=title===siteName?title:title+' · '+siteName;
const schema=article?{'@type':'BlogPosting',headline:title,description,datePublished:article.data.date.toISOString(),author:{'@type':'Organization',name:siteName,url:Astro.site?.href},mainEntityOfPage:url}: {'@type':'WebPage',name:pageTitle,description,url};
---
<!doctype html><html lang="ko"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{pageTitle}</title><meta name="description" content={description}/><link rel="canonical" href={url}/>{noindex&&<meta name="robots" content="noindex"/>}<meta property="og:locale" content="ko_KR"/><meta property="og:site_name" content={siteName}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={url}/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta name="twitter:card" content="summary"/><link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=5"/><link rel="alternate" type="application/rss+xml" title={siteName+' RSS'} href="/rss.xml"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org',...schema}).replace(/</g,'\\u003c')}/><script is:inline>
try {
  const root = document.documentElement;
  const savedTheme = localStorage.getItem('hmmlog-theme');
  if (savedTheme === 'light' || savedTheme === 'dark') root.dataset.theme = savedTheme;
  const size = localStorage.getItem('hmmlog-text-size');
  if (['small', 'normal', 'large', 'larger'].includes(size)) root.dataset.textSize = size;
} catch {}
</script></head>

<body>
<a class="skip" href="#main">본문으로</a>
<header class="topbar">
<a class="brand" href="/"><span>{siteName}</span></a>
<form action="/search/" role="search"><button aria-label="검색"><Icon name="search"/></button><input type="search" name="q" aria-label="블로그 검색" placeholder="블로그 검색" autocomplete="off"/></form>
<div class="tools"><PreferencePicker setting="theme"/><PreferencePicker setting="textSize"/></div>
</header>
<main id="main" class="shell"><slot/></main>
<footer class="shell"><span>© {new Date().getUTCFullYear()} {siteName} · hmmlog.com</span><nav aria-label="블로그 안내"><a href="/categories/">카테고리</a><a href="/rss.xml">RSS</a><a href={`mailto:${email}`}>{email}</a></nav></footer>
</body></html>
