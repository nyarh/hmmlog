---
import '../styles/main.css';
import Icon from '../components/Icon.astro';
import {email, categoryTree, posts} from '../lib/blog';
import CategoryBranches from '../components/CategoryBranches.astro';
import TextSizeDialog from '../components/TextSizeDialog.astro';
const categories = categoryTree(await posts());
const { title='흠', description='흠의 개발 블로그. 웹 개발과 블로그 구현에 관한 글을 모읍니다.', article, noindex=false }=Astro.props;
const url=new URL(Astro.url.pathname,Astro.site).href;
const pageTitle=title==='흠'?title:title+' · 흠';
const schema=article?{'@type':'BlogPosting',headline:title,description,datePublished:article.data.date.toISOString(),author:{'@type':'Organization',name:'흠',url:Astro.site?.href},mainEntityOfPage:url}: {'@type':'WebPage',name:pageTitle,description,url};
---
<!doctype html><html lang="ko"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{pageTitle}</title><meta name="description" content={description}/><link rel="canonical" href={url}/>{noindex&&<meta name="robots" content="noindex"/>}<meta property="og:locale" content="ko_KR"/><meta property="og:site_name" content="흠"/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={url}/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta name="twitter:card" content="summary"/><link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=3"/><link rel="alternate" type="application/rss+xml" title="흠 RSS" href="/rss.xml"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org',...schema}).replace(/</g,'\\u003c')}/><script is:inline>
try {
  const root = document.documentElement;
  if (localStorage.getItem('hmmlog-theme') === 'light') root.dataset.theme = 'light';
  const size = localStorage.getItem('hmmlog-text-size');
  if (['small', 'normal', 'large', 'larger'].includes(size)) root.dataset.textSize = size;
} catch {}
</script></head>

<body>
<a class="skip" href="#main">본문으로</a>
<header class="topbar">
<a class="brand" href="/"><span>흠</span></a>
<form action="/search/" role="search"><button aria-label="검색"><Icon name="search"/></button><input type="search" name="q" aria-label="블로그 검색" placeholder="블로그 검색" autocomplete="off"/></form>
<div class="tools"><button class="tool" id="theme" aria-label="밝은 테마" aria-pressed="false" title="테마 전환"><Icon name="sun"/></button><TextSizeDialog/></div>
</header>
<nav class="rail" aria-label="카테고리 탐색">
  <CategoryBranches nodes={categories} root/>
  <div class="rail-utilities">
    <a href={'mailto:'+email} title="문의" aria-label="문의"><Icon name="mail" size={20}/><span>문의</span></a>
    <a href="/rss.xml" title="RSS" aria-label="RSS"><Icon name="rss" size={20}/><span>RSS</span></a>
  </div>
</nav>
<div class="workarea"><main id="main" class="shell"><slot/></main>
<footer class="shell"><span>© {new Date().getUTCFullYear()} 흠 · hmmlog.com</span><a href={`mailto:${email}`}>{email}</a></footer></div>
<script>
const root=document.documentElement;
const theme=document.querySelector<HTMLButtonElement>('#theme')!;
const themeState=()=>theme.setAttribute('aria-pressed',String(root.dataset.theme==='light'));
themeState();
theme.addEventListener('click',()=>{
  root.dataset.theme=root.dataset.theme==='light'?'dark':'light';
  try{localStorage.setItem('hmmlog-theme',root.dataset.theme)}catch{}
  themeState();
});
</script></body></html>
