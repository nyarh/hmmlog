---
import Icon from './Icon.astro';
import {categoryUrl, type CategoryNode} from '../lib/blog';
interface Props {nodes: CategoryNode[]; root?: boolean}
const {nodes, root = false} = Astro.props;
---
<ul class={root ? 'category-roots' : 'category-children'}>
  {nodes.map(node => <li>
    <a href={categoryUrl(node.path)} title={node.path} aria-label={node.path} aria-current={Astro.url.pathname === categoryUrl(node.path) ? 'page' : undefined}>
      {root && <Icon name={node.name === '미분류' ? 'archive' : 'folder'} size={20}/>}
      <span>{node.name}</span><small>{node.items.length}</small>
    </a>
    {node.children.length > 0 && <div class="category-subtree"><Astro.self nodes={node.children}/></div>}
  </li>)}
</ul>
