---
const sizes = [
  ['small', '작게'], ['normal', '기본'], ['large', '크게'], ['larger', '아주 크게'],
];
---
<div class="size-picker">
  <button class="tool font-trigger" type="button" aria-label="글자 크기 설정" aria-haspopup="dialog" aria-expanded="false" aria-controls="size-dialog" title="글자 크기 설정">Aa</button>
  <div id="size-dialog" role="dialog" aria-label="글자 크기" hidden>
    <div class="size-options">
      {sizes.map(([value,label])=><button type="button" data-size={value} aria-pressed="false">
        <span aria-hidden="true">가</span>{label}
      </button>)}
    </div>
  </div>
</div>
<script>
const picker = document.querySelector<HTMLElement>('.size-picker')!;
const popup = picker.querySelector<HTMLElement>('#size-dialog')!;
const trigger = picker.querySelector<HTMLButtonElement>('.font-trigger')!;
const options = popup.querySelectorAll<HTMLButtonElement>('[data-size]');
const root = document.documentElement;

function closePopup(restoreFocus = false) {
  popup.hidden = true;
  trigger.setAttribute('aria-expanded', 'false');
  if (restoreFocus) trigger.focus();
}

trigger.addEventListener('click', () => {
  if (!popup.hidden) {
    closePopup();
    return;
  }
  const size = root.dataset.textSize || 'normal';
  options.forEach(option => option.setAttribute('aria-pressed', String(option.dataset.size === size)));
  popup.hidden = false;
  trigger.setAttribute('aria-expanded', 'true');
  popup.querySelector<HTMLButtonElement>('[aria-pressed="true"]')?.focus();
});
options.forEach(option => option.addEventListener('click', () => {
  const size = option.dataset.size!;
  root.dataset.textSize = size;
  try { localStorage.setItem('hmmlog-text-size', size); } catch {}
  closePopup(true);
}));
picker.addEventListener('keydown', event => {
  if (event.key === 'Escape' && !popup.hidden) {
    event.preventDefault();
    closePopup(true);
  }
});
picker.addEventListener('focusout', event => {
  if (event.relatedTarget instanceof Node && !picker.contains(event.relatedTarget)) closePopup();
});
document.addEventListener('pointerdown', event => {
  if (!popup.hidden && event.target instanceof Node && !picker.contains(event.target)) closePopup();
});
</script>
