---
import Icon from './Icon.astro';
import {categoryTree,categoryUrl,email,postUrl,dateText,type Post} from '../lib/blog';
const {items}=Astro.props as {items:Post[]};
---
<aside aria-label="블로그 위젯" class="widgets">
  <slot name="top"/>
  <section class="widget"><h2>최근 글</h2><ol class="recent">
    {items.slice(0,4).map((p,i)=><li><span>{String(i+1).padStart(2,'0')}</span><a href={postUrl(p)}><small>{dateText(p.data.date)}</small><strong>{p.data.title}</strong></a></li>)}
  </ol></section>
  <section class="widget"><h2>카테고리</h2>{categoryTree(items).map(node=><a class="chip" href={categoryUrl(node.path)}>{node.name} <small>{node.items.length}</small></a>)}</section>
  <slot/>
  <section class="widget"><h2>문의 / 요청</h2><a class="contact" href={`mailto:${email}`}>{email} <Icon name="outward" size={15}/></a></section>
</aside>
