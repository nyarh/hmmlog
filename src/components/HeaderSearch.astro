---
import Icon from './Icon.astro';
import {siteName} from '../lib/blog';
const label = siteName + ' 검색';
---
<details class="header-search">
  <summary class="tool" aria-label={label} title={label}><Icon name="search"/></summary>
  <form action="/search/" role="search">
    <input type="search" name="q" aria-label={label} placeholder={label} autocomplete="off"/>
    <button type="submit" class="tool" aria-label="검색 실행"><Icon name="arrow"/></button>
  </form>
</details>

<style>
  .header-search {position:relative;margin-inline-start:auto}
  summary {list-style:none;cursor:pointer}
  summary::-webkit-details-marker {display:none}
  form {position:absolute;inset-block-start:calc(100% + 6px);inset-inline-end:0;display:flex;align-items:center;gap:4px;width:min(16rem,calc(100vw - 120px));padding:4px 6px 4px 12px;background:var(--panel);border:1px solid var(--line);border-radius:7px;box-shadow:0 5px 18px #0003}
  button {flex:none}
</style>

<script>
  const search = document.querySelector<HTMLDetailsElement>('.header-search')!;
  const trigger = search.querySelector('summary')!;
  const input = search.querySelector('input')!;
  search.addEventListener('toggle', () => {
    if (search.open) input.focus();
  });
  search.addEventListener('keydown', event => {
    if (event.key === 'Escape' && search.open) {
      event.preventDefault();
      search.open = false;
      trigger.focus();
    }
  });
  function closeOutside(event: Event) {
    if (event.target instanceof Node && !search.contains(event.target)) search.open = false;
  }
  document.addEventListener('pointerdown', closeOutside);
  document.addEventListener('focusin', closeOutside);
</script>
