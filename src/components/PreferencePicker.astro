---
import Icon from './Icon.astro';
const themes = [
  ['system', '시스템 설정 따르기', 'monitor'],
  ['light', '밝은 테마', 'sun'],
  ['dark', '어두운 테마', 'moon'],
];
const sizes = [['small', '작게'], ['normal', '기본'], ['large', '크게'], ['larger', '아주 크게']];
---
<button type="button" class="tool" popovertarget="preferences" aria-label="설정" title="설정">
  <Icon name="settings"/>
</button>
<div id="preferences" class="preference-panel" popover="auto" role="dialog" aria-label="설정">
  <fieldset data-setting="theme" data-storage-key="hmmlog-theme" data-default="system">
    <legend>테마</legend>
    <div class="theme-options">{themes.map(([value, label, icon]) =>
      <button type="button" data-value={value} aria-pressed="false"><Icon name={icon} size={21}/><span>{label}</span></button>
    )}</div>
  </fieldset>
  <fieldset data-setting="textSize" data-storage-key="hmmlog-text-size" data-default="normal">
    <legend>글자 크기</legend>
    <div class="size-options">{sizes.map(([value, label]) =>
      <button type="button" data-value={value} aria-pressed="false"><span aria-hidden="true">가</span>{label}</button>
    )}</div>
  </fieldset>
</div>

<script>
  const root = document.documentElement;
  for (const group of document.querySelectorAll<HTMLFieldSetElement>('#preferences fieldset')) {
    const setting = group.dataset.setting!;
    const key = group.dataset.storageKey!;
    const options = [...group.querySelectorAll<HTMLButtonElement>('[data-value]')];
    function apply(value?: string | null) {
      if (value && value !== 'system' && options.some(option => option.dataset.value === value)) {
        root.dataset[setting] = value;
      } else {
        delete root.dataset[setting];
      }
      const selected = root.dataset[setting] || group.dataset.default;
      for (const option of options) option.setAttribute('aria-pressed', String(option.dataset.value === selected));
    }
    apply(root.dataset[setting]);
    for (const option of options) {
      option.addEventListener('click', () => {
        const value = option.dataset.value!;
        apply(value);
        try {
          if (value === 'system') localStorage.removeItem(key);
          else localStorage.setItem(key, value);
        } catch {}
      });
    }
    window.addEventListener('storage', event => {
      if (event.key === key || event.key === null) apply(event.newValue);
    });
  }
</script>
