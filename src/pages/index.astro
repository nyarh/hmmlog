---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import Icon from '../components/Icon.astro';
import PostList from '../components/PostList.astro';
import Sidebar from '../components/Sidebar.astro';
import {posts} from '../lib/blog';
const items=await posts();
---
<Base><section class="hero"><div class="heroCopy"><div class="prompt"><i/> ~/hmmlog</div><h1>개발 기록<span>.</span></h1><p>웹 개발과 블로그 구현에 관한 기록을 모읍니다.</p></div><div class="drawing"><Art hero/></div><span class="corner tl">+</span><span class="corner br">+</span></section>
<div class="columns"><section><div class="sectionHead"><h2>전체 글 <small>{String(items.length).padStart(2,'0')}</small></h2><span><Icon name="clock" size={14}/> 최신순</span></div><PostList items={items}/></section><Sidebar items={items}/></div></Base>
