---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostList from '../components/PostList.astro';
import Sidebar from '../components/Sidebar.astro';
import {posts,postUrl} from '../lib/blog';
const items=await posts();
const slides=items.slice(0,4);
---
<Base><div class="columns"><div class="stream">
<h1 class="sr">흠 개발 블로그</h1>
{slides.length>0&&<section class="showcase" aria-label="추천 글">
<div class="slide-stage">{slides.map((post,i)=><a class={'feature '+post.data.art} data-slide data-current={i===0?'true':'false'} inert={i!==0} href={postUrl(post)}>
<img class="orbit" src={'/covers/'+post.data.art+'.svg'} alt=""/>
<div class="featureText"><span class="featureTag"><Icon name="post" size={13}/> 추천 글</span><h2>{post.data.title}</h2><p>{post.data.description}</p><span class="read">글 읽기 <Icon name="arrow" size={16}/></span></div>
</a>)}</div>
{slides.length>1&&<div class="pager">{slides.map((p,i)=><button data-pick={i} aria-label={p.data.title+' 보기'} aria-pressed={i===0}></button>)}<button class="rotation" aria-label="자동 전환 일시정지" title="자동 전환 일시정지"><span aria-hidden="true"></span></button></div>}
</section>}
<section><div class="sectionHead"><h2>전체 글 <small>{items.length}</small></h2><span>최신순</span></div><PostList items={items}/></section>
</div><Sidebar items={items}/></div></Base>
<script>
const slides = [...document.querySelectorAll<HTMLElement>('[data-slide]')];
const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-pick]')];
const rotation = document.querySelector<HTMLButtonElement>('.rotation');

if (slides.length > 1 && rotation) {
  let current = 0;
  let paused = false;
  let timer: number;
  const stage = slides[0].parentElement!;
  function schedule() {
    window.clearTimeout(timer);
    if (!paused && !document.hidden && !stage.contains(document.activeElement)) {
      timer = window.setTimeout(() => show((current + 1) % slides.length), 10000);
    }
  }
  function show(index: number) {
    current = index;
    slides.forEach((slide, i) => {
      slide.inert = i !== current;
      slide.dataset.current = String(i === current);
      dots[i].setAttribute('aria-pressed', String(i === current));
    });
    schedule();
  }
  dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
  rotation.addEventListener('click', () => {
    paused = !paused;
    rotation.dataset.paused = String(paused);
    rotation.title = paused ? '자동 전환 재생' : '자동 전환 일시정지';
    rotation.setAttribute('aria-label', rotation.title);
    schedule();
  });
  stage.addEventListener('focusin', () => window.clearTimeout(timer));
  stage.addEventListener('focusout', () => queueMicrotask(schedule));
  document.addEventListener('visibilitychange', schedule);
  window.addEventListener('pageshow', schedule);
  schedule();
}
</script>
