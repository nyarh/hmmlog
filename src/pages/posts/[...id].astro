---
import Base from '../../layouts/Base.astro';
import {render} from 'astro:content';
import {posts,dateText,categoryUrl} from '../../lib/blog';
export async function getStaticPaths(){return (await posts()).map(post=>({params:{id:post.id},props:{post}}))}
const {post}=Astro.props;const {Content}=await render(post);
---
<Base title={post.data.title} description={post.data.description} article={post}><article class="inner article"><a class="back" href="/">← 글 목록</a><div class="meta"><time datetime={post.data.date.toISOString()}>{dateText(post.data.date)}</time><span>·</span><a href={categoryUrl(post.data.category)}>{post.data.category}</a></div><h1>{post.data.title}</h1><p class="lead">{post.data.description}</p><div class="prose"><Content/></div><a class="back" href="/">← 전체 글</a></article></Base>
